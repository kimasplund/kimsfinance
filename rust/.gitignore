# Rust build artifacts
/target/
**/*.rs.bk
*.pdb

# Cargo.lock of this crate IS tracked (dependabot keeps it current).
# cuda-ext is a standalone sub-crate (not a workspace member); its lock stays untracked.
/cuda-ext/Cargo.lock

# Python wheels
*.whl
*.egg-info/
dist/
build/

# PyO3 build artifacts
.maturin/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Data files (large, should not be in repo). Anchored: src/data/ and tests/data/ are source.
*.parquet
/data/
/logs/

# Generated example output (examples/parameter_sweep_optimizer.rs writes results/*.json)
/results/

# Captured cargo check/test logs
/check_output*.txt
/test_output*.txt

# Local NVIDIA/CUTLASS checkout used for the retired FP8 experiments (not a submodule; see build.rs)
/cutlass/

# CSV files (except test data)
*.csv
!tests/**/*.csv

# Python cache
__pycache__/
*.pyc
*.pyo
.pytest_cache/
