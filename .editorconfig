# EditorConfig: https://editorconfig.org
# Mirrors the formatter settings in pyproject.toml ([tool.black], [tool.ruff]) and
# rustfmt defaults so editors agree with the tooling before any hook runs.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{py,pyi,rs}]
max_line_length = 100

[*.toml]
indent_size = 4

[*.{yml,yaml,json,md}]
indent_size = 2

[*.md]
# Two trailing spaces are a Markdown hard line break.
trim_trailing_whitespace = false

[Makefile]
indent_style = tab
